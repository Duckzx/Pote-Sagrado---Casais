{
  "name": "pote-sagrado-casais",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build && esbuild server.ts --bundle --platform=node --target=node18 --outfile=dist/server.cjs --format=cjs --packages=external",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "remotion:studio": "remotion studio src/remotion/index.tsx",
    "remotion:render": "remotion render src/remotion/index.tsx PoteSagradoCommercial out/pote-sagrado-comercial.mp4 --codec=h264 --jpeg-quality=95 --crf=18",
    "remotion:render:preview": "remotion render src/remotion/index.tsx PoteSagradoPreview out/pote-sagrado-preview.mp4 --codec=h264 --scale=0.5",
    "remotion:render:frames": "remotion render src/remotion/index.tsx PoteSagradoCommercial out/frames/ --sequence"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@remotion/player": "^4.0.451",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dom-to-image-more": "^3.7.2",
    "express": "^4.22.1",
    "firebase": "^12.12.0",
    "gsap": "^3.15.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "posthog-js": "^1.372.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.451",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@remotion/cli": "^4.0.451",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
