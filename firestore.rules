rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Data model
    // ===============================================================
    //
    // users/{userId}                         profile, theme, casalId, inviteCode
    // users/{userId}/customDates/{id}        private date ideas
    // casais/{casalId}                       couple doc (isPremium)
    // casais/{casalId}/trip_config/main      goal / trip configuration
    // casais/{casalId}/deposits/{id}         deposits and expenses
    // casais/{casalId}/achievements/{id}     broken pots / photo achievements
    // casais/{casalId}/pinboard_links/{id}   dream board
    // casais/{casalId}/gallery/{id}          shared album
    // casais/{casalId}/love_interactions/{id}
    // casais/{casalId}/love_progress/main
    // casais/{casalId}/notifications/{id}
    // casais/{casalId}/capsules/{id}          time capsule letters
    //
    // deposits/{id}, gallery/{id} (root)     legacy data from old versions,
    //                                        readable by its owner so the app
    //                                        can migrate it into the couple.
    // ===============================================================

    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }

    // A user belongs to their implicit couple (casal_<uid>) or to the couple
    // stored in their profile.
    function isCasalMember(casalId) {
      return isAuthenticated() && (
        casalId == 'casal_' + request.auth.uid ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('casalId', '') == casalId)
      );
    }

    // createdAt: server time for new records, or an older timestamp when a
    // record is being moved (couple link / legacy migration).
    function isValidCreatedAt(data) {
      return data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // Only the keys touched by this write are validated, so records written by
    // older versions (with fields outside today's format) can still be updated.
    function changed() {
      return resource == null
        ? request.resource.data.keys()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    function isValidUser() {
      let data = request.resource.data;
      let keys = changed();
      return (!('theme' in keys) || (data.theme is string && data.theme.size() < 50)) &&
             (!('casalId' in keys) || (data.casalId is string && data.casalId.size() < 100)) &&
             (!('displayName' in keys) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('photoURL' in keys) || (data.photoURL is string && data.photoURL.size() < 1048576)) &&
             (!('inviteCode' in keys) || (data.inviteCode is string && data.inviteCode.size() < 20)) &&
             (!('lgpdConsent' in keys) || data.lgpdConsent is bool) &&
             (!('lgpdConsentDate' in keys) || (data.lgpdConsentDate is string && data.lgpdConsentDate.size() < 50));
    }

    // Writes are merges, so the goal may be saved field by field
    // (missions, push tokens, coordinates...).
    function isValidTripConfig() {
      let data = request.resource.data;
      let keys = changed();
      return (!('destination' in keys) || (data.destination is string && data.destination.size() < 200)) &&
             (!('goalAmount' in keys) || (data.goalAmount is number && data.goalAmount >= 0)) &&
             (!('lat' in keys) || data.lat is number) &&
             (!('lng' in keys) || data.lng is number) &&
             (!('origin' in keys) || (data.origin is string && data.origin.size() < 200)) &&
             (!('customChallenges' in keys) || data.customChallenges is list) &&
             (!('battleChallenges' in keys) || data.battleChallenges is list) &&
             (!('fcmTokens' in keys) || data.fcmTokens is list) &&
             (!('targetDate' in keys) || (data.targetDate is string && data.targetDate.size() <= 30)) &&
             (!('envelopes' in keys) || (data.envelopes is list && data.envelopes.size() <= 100)) &&
             (!('monthlyPrize' in keys) || (data.monthlyPrize is string && data.monthlyPrize.size() < 300));
    }

    function isValidDeposit(data) {
      return data.keys().hasAll(['amount', 'who', 'createdAt']) &&
             data.amount is number &&
             isValidCreatedAt(data) &&
             (!('type' in data) || data.type in ['income', 'expense']) &&
             (
               // Deposit/expense made (or moved between couples) by its author
               (data.who == request.auth.uid && data.amount >= 0) ||
               // XP bonus (amount 0) given to the partner when sharing
               (data.get('isXpBonus', false) == true && data.amount == 0)
             );
    }

    function isValidAchievement(data) {
      return data.keys().hasAll(['destination', 'amount', 'goalAmount', 'createdAt']) &&
             data.destination is string && data.destination.size() < 200 &&
             data.amount is number &&
             data.goalAmount is number &&
             (!('title' in data) || (data.title is string && data.title.size() <= 200)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 1048576)) &&
             isValidCreatedAt(data);
    }

    function isValidPinboardLink(data) {
      return data.keys().hasAll(['url', 'title', 'createdAt']) &&
             data.url is string && data.url.size() <= 2048 &&
             data.title is string && data.title.size() <= 200 &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 1048576)) &&
             (!('addedBy' in data) || data.addedBy is string) &&
             isValidCreatedAt(data);
    }

    function isValidGalleryPhoto(data) {
      return data.keys().hasAll(['addedBy', 'createdAt']) &&
             (data.keys().hasAny(['imageBase64', 'imageUrl'])) &&
             (!('imageBase64' in data) || (data.imageBase64 is string && data.imageBase64.size() < 1048576)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() < 1048576)) &&
             data.addedBy == request.auth.uid &&
             isValidCreatedAt(data);
    }

    // ===============================================================
    // Users
    // ===============================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) && isValidUser();
      allow delete: if isOwner(userId);

      match /customDates/{dateId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // Couples
    // ===============================================================
    match /casais/{casalId} {
      allow read: if isCasalMember(casalId);
      // mode: 'solo' | 'casal' | 'grupo'; groupName shown in group pots
      allow create, update: if isCasalMember(casalId)
                            && (!('mode' in changed()) || request.resource.data.mode in ['solo', 'casal', 'grupo'])
                            && (!('groupName' in changed()) || (request.resource.data.groupName is string && request.resource.data.groupName.size() <= 60));

      match /trip_config/{docId} {
        allow read: if isCasalMember(casalId);
        allow create, update: if isCasalMember(casalId) && isValidTripConfig();
      }

      match /deposits/{depositId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId) && isValidDeposit(request.resource.data);
        allow delete: if isCasalMember(casalId);
        // Anyone in the couple/group may fix a record (value, description,
        // date, comments, reactions); the author (`who`) never changes.
        allow update: if isCasalMember(casalId)
                      && request.resource.data.get('who', null) == resource.data.get('who', null)
                      && (!('amount' in changed()) || request.resource.data.amount is number)
                      && (!('createdAt' in changed()) || request.resource.data.createdAt is timestamp)
                      && (!('type' in changed()) || request.resource.data.type in ['income', 'expense']);
      }

      match /achievements/{achievementId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId) && isValidAchievement(request.resource.data);
        allow update: if isCasalMember(casalId) && isValidAchievement(request.resource.data);
        allow delete: if isCasalMember(casalId);
      }

      match /pinboard_links/{linkId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId) && isValidPinboardLink(request.resource.data);
        allow update: if isCasalMember(casalId) && isValidPinboardLink(request.resource.data);
        allow delete: if isCasalMember(casalId);
      }

      match /gallery/{photoId} {
        allow read: if isCasalMember(casalId);
        allow create, update: if isCasalMember(casalId) && isValidGalleryPhoto(request.resource.data);
        allow delete: if isCasalMember(casalId);
      }

      match /love_interactions/{interactionId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId)
                      && request.resource.data.partnerId == request.auth.uid
                      && request.resource.data.cardId is string;
        allow update, delete: if isCasalMember(casalId) && resource.data.partnerId == request.auth.uid;
      }

      match /love_progress/{docId} {
        allow read, write: if isCasalMember(casalId);
      }

      match /capsules/{capsuleId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId)
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.message is string
                      && request.resource.data.message.size() <= 2000
                      && request.resource.data.openAt is timestamp;
        // Anyone in the couple may mark it as opened once the date arrives
        allow update: if isCasalMember(casalId)
                      && resource.data.openAt <= request.time
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['openedAt']);
        allow delete: if isCasalMember(casalId) && resource.data.from == request.auth.uid;
      }

      match /notifications/{notificationId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId) && request.resource.data.from == request.auth.uid;
        allow update: if isCasalMember(casalId)
                      && resource.data.to == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isCasalMember(casalId) && resource.data.to == request.auth.uid;
      }
    }

    // ===============================================================
    // Legacy (pre-couple) data: owner can read it to migrate it.
    // ===============================================================
    match /deposits/{depositId} {
      allow read: if isAuthenticated() && resource.data.who == request.auth.uid;
    }

    match /gallery/{photoId} {
      allow read: if isAuthenticated() && resource.data.addedBy == request.auth.uid;
    }
  }
}
