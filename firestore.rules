rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isAuthenticated() { return request.auth != null; }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isCasalMember(casalId) {
      return isAuthenticated() && getUserData().casalId == casalId;
    }

    // Collection: users
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow creation if the userId matches auth.uid. Strict validation on fields.
      allow create: if request.auth.uid == userId
        && (!request.resource.data.keys().hasAny(['isPremium']))
        && (request.resource.data.casalId == 'casal_' + userId || !request.resource.data.keys().hasAny(['casalId']));

      // Allow update only of non-security fields
      allow update: if request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['casalId', 'isPremium', 'inviteCode']);

      match /customDates/{dateId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Collection: casais (Root documents)
    match /casais/{casalId} {
      allow read: if isCasalMember(casalId);
      // isPremium should ONLY be written by backend/Cloud Functions
      allow create, update: if false;
      
      // Subcollections within a casal
      match /trip_config/{docId} {
         allow read: if isCasalMember(casalId);
         allow write: if isCasalMember(casalId); // Validation could be added here
      }
      
      match /deposits/{depositId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId) && request.resource.data.who == request.auth.uid;
        allow delete: if isCasalMember(casalId) && resource.data.who == request.auth.uid;
        allow update: if isCasalMember(casalId) 
                      && (
                        (resource.data.who == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['who', 'createdAt'])) ||
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'reactions']))
                      );
      }

      match /achievements/{achievementId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId);
        allow delete: if isCasalMember(casalId);
      }

      match /pinboard_links/{linkId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId);
        allow delete: if isCasalMember(casalId) && resource.data.addedBy == request.auth.uid;
      }

      match /gallery/{photoId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId) && request.resource.data.addedBy == request.auth.uid;
        allow delete: if isCasalMember(casalId) && resource.data.addedBy == request.auth.uid;
      }

      match /notifications/{notifId} {
        allow read: if isCasalMember(casalId) && resource.data.to == request.auth.uid;
        allow create: if isCasalMember(casalId) && request.resource.data.from == request.auth.uid;
        allow update: if isCasalMember(casalId) && resource.data.to == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isCasalMember(casalId) && resource.data.to == request.auth.uid;
      }

      match /love_interactions/{interId} {
        allow read: if isCasalMember(casalId);
        allow create: if isCasalMember(casalId) && request.resource.data.partnerId == request.auth.uid;
        allow update, delete: if false; // Interactions are typically permanent
      }

      match /love_progress/{docId} {
        allow read: if isCasalMember(casalId);
        allow write: if isCasalMember(casalId); // This might need more control later
      }
    }
  }
}
