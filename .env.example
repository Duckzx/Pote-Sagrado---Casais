# VITE_FIREBASE_VAPID_KEY: chave Web Push para notificações nativas (Firebase Cloud Messaging).
# Firebase Console -> Configurações do projeto -> Cloud Messaging -> Certificados Web Push.
VITE_FIREBASE_VAPID_KEY=""

# VITE_FIREBASE_AUTH_DOMAIN (opcional): use o domínio do próprio site (ex: pote-sagrado-casais.vercel.app)
# para o login por redirecionamento funcionar no Safari/iOS. Exige adicionar
# https://SEU_DOMINIO/__/auth/handler nas URIs de redirecionamento do cliente OAuth no Google Cloud.
VITE_FIREBASE_AUTH_DOMAIN=""

# VITE_POSTHOG_KEY / VITE_POSTHOG_HOST (opcional): analytics. Sem chave, nada é enviado.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST=""
